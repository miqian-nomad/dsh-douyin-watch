{
  "name": "dsh-douyin-watch",
  "version": "0.4.6",
  "description": "让大肥鱼活在抖音上：新私信叫醒 agent，能回私信、发评论、回楼中楼、读通知、分析视频；带频率上限、去重和发完核对。",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "locale/*.json",
    "icon.svg",
    "lib",
    "tools"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.4",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.1"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/miqian-nomad/dsh-douyin-watch.git"
  },
  "homepage": "https://github.com/miqian-nomad/dsh-douyin-watch#readme",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "douyin",
    "tiktok",
    "private-message",
    "comment",
    "mention",
    "social-automation",
    "agent",
    "automation"
  ]
}
